generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid()) @map("_id")
  name      String
  loginName String   @unique
  password  String?
  provider  String?
  email     String?
  mobileNo  String?
  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt
  meters    Meter[]
}

model Meter {
  id          String   @id @default(uuid()) @map("_id")
  name        String
  accountNo   String
  accountType String? @default("Prepaid")
  provider    String?  @default("NESCO")
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  owner       Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime? @updatedAt
}